<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Title and Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Habits Today"
            android:textColor="#E6E0E9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textColor="#D0BCFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#D0BCFF" />

    <!-- Slot 1 -->
    <LinearLayout
        android:id="@+id/habit_slot_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/habit_btn_1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_circle_unchecked"
            android:contentDescription="Check habit" />

        <TextView
            android:id="@+id/habit_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Habit 1"
            android:textColor="#ECE0E9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/habit_streak_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0"
            android:textColor="#FFB74D"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Slot 2 -->
    <LinearLayout
        android:id="@+id/habit_slot_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/habit_btn_2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_circle_unchecked"
            android:contentDescription="Check habit" />

        <TextView
            android:id="@+id/habit_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Habit 2"
            android:textColor="#ECE0E9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/habit_streak_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0"
            android:textColor="#FFB74D"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Slot 3 -->
    <LinearLayout
        android:id="@+id/habit_slot_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/habit_btn_3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_circle_unchecked"
            android:contentDescription="Check habit" />

        <TextView
            android:id="@+id/habit_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Habit 3"
            android:textColor="#ECE0E9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/habit_streak_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0"
            android:textColor="#FFB74D"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Empty state text -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Tap to open Habit Tracker"
        android:textColor="#938F99"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
