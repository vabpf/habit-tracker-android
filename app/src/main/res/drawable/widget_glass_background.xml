<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass widget card: translucent fill so the wallpaper shows
     through, a subtle top sheen, and a light gradient-style border.
     Mirrors FrostGlassDefaults (dark) from the in-app glass effect. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: dark fill at ~72% opacity -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B816181F" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Top sheen: white fading out halfway down -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:centerColor="#08FFFFFF"
                android:centerY="0.25"
                android:endColor="#00000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Light border, inset so the stroke isn't clipped -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>

</layer-list>
